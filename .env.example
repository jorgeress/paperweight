NEBIUS_API_KEY=
# live calls the api, record also saves responses to recordings/, replay never touches the network
PAPERWEIGHT_MODE=record
# rtsp://user:pass@192.168.1.50:554/stream2, or a webcam index such as 0
CAMERA_SOURCE=0
# leave empty, or point at a missing port, to use the simulated station
STATION_PORT=/dev/ttyACM0
